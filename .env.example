# .env.example — zelinho-ia
# SOMENTE NOMES. Nunca commite valores reais. Em produção, configure no Coolify (Environment Variables).
# Só OPENAI_API_KEY e PINECONE_API_KEY são obrigatórias. As demais estão comentadas: descomente e preencha quando precisar (valores vazios quebram campos bool/int).

# --- OpenAI / modelos ---
OPENAI_API_KEY=
# OPENAI_MODEL=   (padrão: 'gpt-5')
# OPENAI_MODEL_FAST=   (padrão: 'gpt-4o-mini')
# OPENAI_EMBEDDING_MODEL=   (padrão: 'text-embedding-3-small')
# INTAKE_CONVERSATION_MODEL=   (padrão: 'gpt-5-mini')

# --- Negociação ---
# NEGOTIATION_MODEL=   (padrão: 'gpt-5')
# NEGOTIATION_TEMPERATURE=   (padrão: 0.2)
# NEGOTIATION_MAX_ROUNDS=   (padrão: 6)
# NEGOTIATION_ROUNDS_AFTER_REJECTION=   (padrão: 3)
# NEGOTIATION_MAX_CLIENT_REJECTIONS=   (padrão: 3)
# NEGOTIATION_LEDGER_ENABLED=   (padrão: True)
# NEGOTIATION_LEDGER_MODEL=   (padrão: 'gpt-4o-mini')
# NEGOTIATION_MAX_TOOL_CALLS=   (padrão: 2)
# NEGOTIATION_LLM_TIMEOUT_S=   (padrão: 55.0)
# NEGOTIATION_TERMINAL_DISPATCH_ENABLED=   (padrão: True)
# NEGOTIATION_REQUEST_ENABLED=   (padrão: True)
# NEGOTIATION_VISION_ENABLED=   (padrão: True)
# NEGOTIATION_DISPATCH_IDEMPOTENCY_ENABLED=   (padrão: True)
# NEGOTIATION_DISPATCH_IDEMPOTENCY_TIMEOUT=   (padrão: 5.0)

# --- API / serviço ---
# API_HOST=   (padrão: '0.0.0.0')
# API_PORT=   (padrão: 8000)
# API_TITLE=   (padrão: 'Zellinho')
# API_KEY_ZELLU_IA=   ([segredo])
# AI_WEBHOOK_HMAC_SECRET=   ([segredo])
# AI_USAGE_ENABLED=   (padrão: True)
# API_KEY_IA_PRODUCTION=   ([segredo])
# AI_USAGE_TIMEOUT_MS=   (padrão: 8000)
# SERVICE_BASE_URL=   (padrão: 'http://localhost:8000')
# RATE_LIMIT_REQUESTS=   (padrão: 10)
# RATE_LIMIT_WINDOW=   (padrão: 60)

# --- ElevenLabs (canal de voz) ---
