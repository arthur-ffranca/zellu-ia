# ELEVENLABS_AGENT_ID=   (padrão: '')
# ELEVENLABS_WEBHOOK_SECRET=   ([segredo])
# CLIENT_INTAKE_RECORD_ENABLED=   (padrão: False)
# ELEVENLABS_API_URL=   (padrão: 'https://api.elevenlabs.io')
# ELEVENLABS_VOICE_MODEL=   (padrão: 'eleven_turbo_v2_5')

# --- Backend Zellu / callbacks ---
# ZELLU_WEBHOOK_URL=   (padrão em config.py (URL interna))
